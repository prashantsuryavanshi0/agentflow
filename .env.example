# ---- Next.js frontend (public) ----
NEXT_PUBLIC_NHOST_SUBDOMAIN=localhost
NEXT_PUBLIC_NHOST_REGION=

# ---- Nhost / Hasura (used by nhost.toml + functions) ----
HASURA_GRAPHQL_ADMIN_SECRET=changeme-admin-secret
HASURA_GRAPHQL_WEBHOOK_SECRET=changeme-webhook-secret
NHOST_GRAPHQL_URL=http://localhost:1337/v1/graphql
NHOST_FUNCTIONS_BASE_URL=http://localhost:1337/v1/functions
NHOST_FUNCTIONS_EVENT_WEBHOOK_URL=http://localhost:1337/v1/functions/events/on-workflow-event-insert

APP_URL=http://localhost:3000

# Shared secret the frontend never sees — Hasura attaches this header
# to every Action/cron call so the function can confirm the request
# actually came from Hasura and not a stray public POST to the URL.
ACTION_SECRET=changeme-action-secret
EVENT_TRIGGER_SECRET=changeme-event-secret

# ---- LLM provider for llm_call steps (Groq free tier) ----
# Leave unset to use the disclosed stub with an artificial delay.
GROQ_API_KEY=
